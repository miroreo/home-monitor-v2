# Home Assistant
HA_BASE_URL=https://your-home-assistant-url
HA_TOKEN=your-long-lived-access-token

# CTA TrainTracker / BusTracker
CTA_TRAINTRACKER_KEY=your-traintracker-api-key
CTA_BUSTRACKER_KEY=your-bustracker-api-key
CTA_TRAIN_STATIONS=comma,separated,station,mapids
CTA_BUS_STOPS=comma,separated,stop,ids

# Weather (Open-Meteo) - lat,lon
WEATHER_LOCATION=41.8290,-87.6272

# PIN or PSK required to unlock Home Assistant controls on the dashboard.
# Leave unset to keep Home controls disabled.
HA_CONTROL_SECRET=
